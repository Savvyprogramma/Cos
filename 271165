* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  color: #333;
  background: #000000;
}

section, header, footer {
  padding: 60px 20px;
  max-width: 800px;
  margin: auto;
  text-align: center;
}

.hero {
  background: #0a66c2;
  color: white;
  padding: 80px 20px;
}

.profile-img {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  border: 4px solid white;
  margin-bottom: 20px;
  object-fit: cover;
}

h1 { font-size: 2rem; margin-bottom: 10px; }
h2 { font-size: 1.5rem; margin-bottom: 20px; color: #0a66c2; }
p { margin-bottom: 15px; }

.tagline { font-style: italic; opacity: 0.9; }


#skills{

  padding: 20px;
  border-radius: 10px;
  margin-bottom: 30px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  background: #0a66c2;
  
}

#skills h2{
    color: black;
}
 
#about h2{
    color: black;
}

#about{
    padding: 20px;
  border-radius: 10px;
  margin-bottom: 30px;
  margin-top: 30px;
   font-size: 20px;      
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  background:#0a66c2;
}


.btn, .btn-small {
  display: inline-block;
  background: white;
  color: #0a66c2;
  padding: 12px 24px;
  border-radius: 5px;
  text-decoration: none;
  margin-top: 15px;
  font-weight: bold;
}

.btn-small {
  background: #0a66c2;
  color: white;
  padding: 8px 16px;
  font-size: 0.9rem;
}

.skills-grid {
  display: grid;
  
  gap: 15px;
  margin-top: 20px;
}

.skill {
  background: white;
    
  padding: 15px;
  border-radius: 8px;
  box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.project {
  background: white;
  padding: 20px;
  border-radius: 10px;
  margin-bottom: 30px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.project img {
  width: 100%;
  max-width: 400px;
  border-radius: 8px;
  margin-bottom: 15px;
}

footer {
  background: #222;
  color: white;
}

footer a { color: #4da3ff; text-decoration: none; }

@media (max-width: 600px) {
  h1 { font-size: 1.6rem; }
  section { padding: 40px 15px; }

   
}



